<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- The system icon-only preview cannot represent the full artwork. -->
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSplashScreenBackground">#063B2F</item>
        <!-- Android masks splash icons; show the complete artwork in Flutter. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:statusBarColor">#063B2F</item>
        <item name="android:navigationBarColor">#063B2F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>

