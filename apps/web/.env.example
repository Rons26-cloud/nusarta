# Public site configuration. Copy to .env.local and adjust per environment.
# Keep this to public values only. Never add service_role keys, DB passwords,
# or signing secrets here (those belong on the server / protected backend).

# Public base URL used for absolute canonical URLs, sitemap, and OG tags.
# Leave empty if no public domain is finalized yet.
NEXT_PUBLIC_SITE_URL=

# Where release APKs are served from. Leave empty to use the built-in
# /downloads folder under public/.
NEXT_PUBLIC_DOWNLOAD_URL=

# Email address shown on the Contact page. Leave empty until the official
# support address is active; the site then shows a "not configured" notice
# instead of a working-looking fake address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Replaces build placeholder emails; only public info.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_PORTAL_URL=